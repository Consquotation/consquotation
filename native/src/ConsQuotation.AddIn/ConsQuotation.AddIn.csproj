<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8 có sẵn trên Windows 10/11: người dùng không phải cài thêm runtime. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ConsQuotation</RootNamespace>
    <AssemblyName>ConsQuotation</AssemblyName>
    <!-- Excel-DNA: tên add-in hiện trong Excel và tên file .xll (bản 32-bit và 64-bit). -->
    <ExcelAddInName>ConsQuotation</ExcelAddInName>
    <ExcelAddInFileName>ConsQuotation</ExcelAddInFileName>
    <!-- DLL phụ phải đóng gói vào .xll (bộ cài chỉ chép file .xll). -->
    <ExcelAddInInclude>ConsQuotation.Core.dll;Newtonsoft.Json.dll</ExcelAddInInclude>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConsQuotation.Core\ConsQuotation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gọi mô hình đối tượng COM của Excel bằng dynamic (không cần PIA); có sẵn trong .NET Framework. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ConsQuotation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Ribbon\Ribbon.xml" LogicalName="ConsQuotation.Ribbon.xml" />
  </ItemGroup>

</Project>
