<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Manifest DEVELOPMENT của ConsQuotation (ADR-0002).
  - Trỏ tới webpack dev server trên máy (cổng 3000).
  - Manifest production được sinh khi build production bằng cách thay URL dev
    bằng biến môi trường CQ_PROD_URL (xem webpack.config.js, ADR-0005).
  - Bản dev có Id và tên riêng ("ConsQuotation (Dev)") để cài song song với bản production;
    build production thay về Id và tên chính thức.
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>03040238-2423-498b-b0fe-30f0425b2ed2</Id>
  <!-- Trình kiểm tra manifest yêu cầu Version >= 1.0; tăng phiên bản này mỗi lần phát hành manifest mới. -->
  <Version>1.4.0.0</Version>
  <ProviderName>ConsQuotation</ProviderName>
  <DefaultLocale>vi-VN</DefaultLocale>
  <DisplayName DefaultValue="ConsQuotation (Dev)"/>
  <Description DefaultValue="Lập báo giá thi công xây dựng ngay trong Excel, với thư viện công tác và đơn giá do chính bạn quản lý."/>
  <IconUrl DefaultValue="https://localhost:3000/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/help.html"/>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <!-- ExcelApi 1.1 để add-in cài được từ Excel 2016; mức tối thiểu lúc chạy (1.8) được kiểm tra trong code. -->
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <!--
            Chỉ hiển thị lệnh đã có implementation (prompts/05_RIBBON_TASKPANE_UX.md).
            Các nút dùng chung TaskpaneId: pane được giữ mở và nội dung thay bằng SourceLocation của nút.
          -->
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <CustomTab id="CQ.Tab">
              <Group id="CQ.Group.Main">
                <Label resid="CQ.Group.Main.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="CQ.OpenTaskpane">
                  <Label resid="CQ.OpenTaskpane.Label"/>
                  <Supertip>
                    <Title resid="CQ.OpenTaskpane.Label"/>
                    <Description resid="CQ.OpenTaskpane.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CQ.MainTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="CQ.CreateQuote">
                  <Label resid="CQ.CreateQuote.Label"/>
                  <Supertip>
                    <Title resid="CQ.CreateQuote.Label"/>
                    <Description resid="CQ.CreateQuote.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="TableAdd.16x16"/>
                    <bt:Image size="32" resid="TableAdd.32x32"/>
                    <bt:Image size="80" resid="TableAdd.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CQ.MainTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Quote.Url"/>
                  </Action>
                </Control>
                <Control xsi:type="Button" id="CQ.OpenLibrary">
                  <Label resid="CQ.OpenLibrary.Label"/>
                  <Supertip>
                    <Title resid="CQ.OpenLibrary.Label"/>
                    <Description resid="CQ.OpenLibrary.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Library.16x16"/>
                    <bt:Image size="32" resid="Library.32x32"/>
                    <bt:Image size="80" resid="Library.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CQ.MainTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Library.Url"/>
                  </Action>
                </Control>
              </Group>
              <Group id="CQ.Group.Help">
                <Label resid="CQ.Group.Help.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Help.16x16"/>
                  <bt:Image size="32" resid="Help.32x32"/>
                  <bt:Image size="80" resid="Help.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="CQ.OpenHelp">
                  <Label resid="CQ.OpenHelp.Label"/>
                  <Supertip>
                    <Title resid="CQ.OpenHelp.Label"/>
                    <Description resid="CQ.OpenHelp.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Help.16x16"/>
                    <bt:Image size="32" resid="Help.32x32"/>
                    <bt:Image size="80" resid="Help.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>CQ.MainTaskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Help.Url"/>
                  </Action>
                </Control>
              </Group>
              <Label resid="CQ.Tab.Label"/>
            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/assets/icon-80.png"/>
        <bt:Image id="TableAdd.16x16" DefaultValue="https://localhost:3000/assets/table-add-16.png"/>
        <bt:Image id="TableAdd.32x32" DefaultValue="https://localhost:3000/assets/table-add-32.png"/>
        <bt:Image id="TableAdd.80x80" DefaultValue="https://localhost:3000/assets/table-add-80.png"/>
        <bt:Image id="Library.16x16" DefaultValue="https://localhost:3000/assets/library-16.png"/>
        <bt:Image id="Library.32x32" DefaultValue="https://localhost:3000/assets/library-32.png"/>
        <bt:Image id="Library.80x80" DefaultValue="https://localhost:3000/assets/library-80.png"/>
        <bt:Image id="Help.16x16" DefaultValue="https://localhost:3000/assets/help-16.png"/>
        <bt:Image id="Help.32x32" DefaultValue="https://localhost:3000/assets/help-32.png"/>
        <bt:Image id="Help.80x80" DefaultValue="https://localhost:3000/assets/help-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/taskpane.html"/>
        <bt:Url id="Taskpane.Quote.Url" DefaultValue="https://localhost:3000/taskpane.html?view=quote"/>
        <bt:Url id="Taskpane.Library.Url" DefaultValue="https://localhost:3000/taskpane.html?view=library"/>
        <bt:Url id="Taskpane.Help.Url" DefaultValue="https://localhost:3000/taskpane.html?view=help"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CQ.Tab.Label" DefaultValue="ConsQuotation (Dev)"/>
        <bt:String id="CQ.Group.Main.Label" DefaultValue="Báo giá"/>
        <bt:String id="CQ.OpenTaskpane.Label" DefaultValue="Mở ConsQuotation"/>
        <bt:String id="CQ.CreateQuote.Label" DefaultValue="Tạo bảng báo giá"/>
        <bt:String id="CQ.OpenLibrary.Label" DefaultValue="Thư viện của tôi"/>
        <bt:String id="CQ.Group.Help.Label" DefaultValue="Trợ giúp"/>
        <bt:String id="CQ.OpenHelp.Label" DefaultValue="Trợ giúp"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="CQ.OpenTaskpane.Tooltip" DefaultValue="Mở bảng điều khiển ConsQuotation: xem workbook hiện tại, tạo bảng báo giá và các lối tắt."/>
        <bt:String id="CQ.CreateQuote.Tooltip" DefaultValue="Mở phần Tạo bảng báo giá: chọn sheet mới hoặc ô đang chọn, add-in kiểm tra vùng đích trước khi ghi."/>
        <bt:String id="CQ.OpenLibrary.Tooltip" DefaultValue="Quản lý công tác, tài nguyên, giá và định mức do bạn tự tạo; chèn công tác từ thư viện vào bảng báo giá."/>
        <bt:String id="CQ.OpenHelp.Tooltip" DefaultValue="Mở hướng dẫn sử dụng ConsQuotation."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
